#pragma once


#include <Trade/Trade.mqh>

#include "CoreTypes.mqh"



class ExecutionEngine
{


private:


CTrade trade;


ulong magic;


int slippage;



public:



ExecutionEngine()
{

magic=20260729;

slippage=20;

}



//------------------------------------------------------------
// INITIALIZE
//------------------------------------------------------------

void Init(
ulong magicNumber,
int deviation
)
{

magic=magicNumber;

slippage=deviation;



trade.SetExpertMagicNumber(
magic
);


trade.SetDeviationInPoints(
slippage
);


}



//------------------------------------------------------------
// CHECK POSITION
//------------------------------------------------------------

bool HasPosition()
{


for(int i=PositionsTotal()-1;i>=0;i--)
{


ulong ticket =
PositionGetTicket(i);



if(ticket==0)
continue;



if(PositionGetString(
POSITION_SYMBOL
)
!=_Symbol)

continue;



if(PositionGetInteger(
POSITION_MAGIC
)
!=magic)

continue;



return true;


}


return false;


}



//------------------------------------------------------------
// OPEN BUY
//------------------------------------------------------------

bool Buy(
double lots,
double sl,
double tp
)
{


if(HasPosition())
return false;



double price =
SymbolInfoDouble(
_Symbol,
SYMBOL_ASK
);



bool result =
trade.Buy(
lots,
_Symbol,
price,
sl,
tp,
"AEGIS LONG"
);



if(!result)
{

Print(
"AEGIS BUY FAILED: ",
trade.ResultRetcodeDescription()
);

}



return result;


}



//------------------------------------------------------------
// OPEN SELL
//------------------------------------------------------------

bool Sell(
double lots,
double sl,
double tp
)
{


if(HasPosition())
return false;



double price =
SymbolInfoDouble(
_Symbol,
SYMBOL_BID
);



bool result =
trade.Sell(
lots,
_Symbol,
price,
sl,
tp,
"AEGIS SHORT"
);



if(!result)
{

Print(
"AEGIS SELL FAILED: ",
trade.ResultRetcodeDescription()
);

}



return result;


}



//------------------------------------------------------------
// CLOSE POSITION
//------------------------------------------------------------

void Close()
{


for(int i=PositionsTotal()-1;i>=0;i--)
{


ulong ticket =
PositionGetTicket(i);



if(ticket==0)
continue;



if(PositionGetString(
POSITION_SYMBOL
)
!=_Symbol)

continue;



if(PositionGetInteger(
POSITION_MAGIC
)
!=magic)

continue;



trade.PositionClose(
ticket
);


}



}



//------------------------------------------------------------
// TRADE STATE
//------------------------------------------------------------

ExecutionState GetState()
{


ExecutionState state;


state.hasPosition=false;


state.isLong=false;


state.isShort=false;



for(int i=PositionsTotal()-1;i>=0;i--)
{


ulong ticket =
PositionGetTicket(i);



if(ticket==0)
continue;



if(PositionGetString(
POSITION_SYMBOL
)
!=_Symbol)

continue;



if(PositionGetInteger(
POSITION_MAGIC
)
!=magic)

continue;



state.hasPosition=true;



ENUM_POSITION_TYPE type =
(ENUM_POSITION_TYPE)
PositionGetInteger(
POSITION_TYPE
);



if(type==POSITION_TYPE_BUY)

state.isLong=true;


if(type==POSITION_TYPE_SELL)

state.isShort=true;



state.entryPrice =
PositionGetDouble(
POSITION_PRICE_OPEN
);



state.stopLoss =
PositionGetDouble(
POSITION_SL
);



state.takeProfit =
PositionGetDouble(
POSITION_TP
);



}



return state;


}


};
