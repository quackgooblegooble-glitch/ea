//============================================================

struct ConfidenceState
{

   double totalScore;


   double longScore;

   double shortScore;



   bool allowLong;

   bool allowShort;

   bool allowTrade;



   string grade;

};

//+------------------------------------------------------------------+
//|                AEGIS Confidence Engine                          |
//|                Multi-System Decision Layer                      |
//+------------------------------------------------------------------+

#pragma once


#include "CoreTypes.mqh"



class ConfidenceEngine
{


private:


ConfidenceState state;



public:


//------------------------------------------------------------
// CALCULATE
//------------------------------------------------------------


void Calculate(

RegimeState regime,

StructureState structure,

VWAPState vwap,

VolumeProfileState volume,

LiquidityState liquidity,

MomentumState momentum

)
{


double longScore=0;

double shortScore=0;



//============================================================
// REGIME
//============================================================


if(
regime.regime ==
REGIME_STRONG_BULL
)
{

longScore+=30;

}


else if(
regime.regime ==
REGIME_BULL
)
{

longScore+=20;

}



if(
regime.regime ==
REGIME_STRONG_BEAR
)
{

shortScore+=30;

}


else if(
regime.regime ==
REGIME_BEAR
)
{

shortScore+=20;

}



//============================================================
// STRUCTURE
//============================================================


if(structure.higherHigh)
longScore+=10;


if(structure.higherLow)
longScore+=10;



if(structure.lowerHigh)
shortScore+=10;


if(structure.lowerLow)
shortScore+=10;



//============================================================
// VWAP
//============================================================


if(vwap.aboveDaily)
longScore+=5;

else
shortScore+=5;



if(vwap.aboveWeekly)
longScore+=5;

else
shortScore+=5;



if(vwap.aboveMonthly)
longScore+=5;

else
shortScore+=5;



//============================================================
// VOLUME PROFILE
//============================================================


if(volume.abovePOC)
longScore+=7;

else
shortScore+=7;



if(volume.insideValue)
{

// neutral zone

longScore+=2;

shortScore+=2;

}



//============================================================
// LIQUIDITY
//============================================================


if(liquidity.bullishSweep)
longScore+=10;



if(liquidity.bearishSweep)
shortScore+=10;



//============================================================
// MOMENTUM
//============================================================


if(momentum.bullish)
longScore+=5;



if(momentum.bearish)
shortScore+=5;



//============================================================
// FINAL
//============================================================


state.longScore =
longScore;


state.shortScore =
shortScore;



state.totalScore =
MathMax(
longScore,
shortScore
);



//------------------------------------------------------------
// Permission
//------------------------------------------------------------


state.allowLong =
(
longScore>=80 &&
longScore>shortScore
);



state.allowShort =
(
shortScore>=80 &&
shortScore>longScore
);



state.allowTrade =
(
state.allowLong ||
state.allowShort
);



//------------------------------------------------------------
// Grade
//------------------------------------------------------------


if(state.totalScore>=95)

state.grade="A+";


else if(state.totalScore>=90)

state.grade="A";


else if(state.totalScore>=85)

state.grade="B";


else if(state.totalScore>=80)

state.grade="C";


else

state.grade="NO TRADE";



}



//------------------------------------------------------------

ConfidenceState GetState()
{

return state;

}


};
