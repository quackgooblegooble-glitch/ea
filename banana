#pragma once


#include "CoreTypes.mqh"



class RegimeEngine
{


private:


StructureState structure;

VWAPState vwap;

VolatilityState volatility;

VolumeProfileState volume;

LiquidityState liquidity;



RegimeState state;



public:



void Update(

StructureState _structure,

VWAPState _vwap,

VolatilityState _volatility,

VolumeProfileState _volume,

LiquidityState _liquidity

)
{


structure=_structure;

vwap=_vwap;

volatility=_volatility;

volume=_volume;

liquidity=_liquidity;



Calculate();

}




//------------------------------------------------------------
// MAIN CLASSIFICATION
//------------------------------------------------------------


void Calculate()
{


double bull=0;

double bear=0;

double range=0;



//============================================================
// STRUCTURE
//============================================================


if(structure.higherHigh)
bull+=20;


if(structure.higherLow)
bull+=15;



if(structure.lowerHigh)
bear+=20;


if(structure.lowerLow)
bear+=15;




//============================================================
// VWAP ALIGNMENT
//============================================================


if(vwap.aboveDaily)
bull+=5;

else
bear+=5;



if(vwap.aboveWeekly)
bull+=10;

else
bear+=10;



if(vwap.aboveMonthly)
bull+=5;

else
bear+=5;



//============================================================
// VOLATILITY
//============================================================


if(volatility.expanding)
{

bull+=5;

bear+=5;

}



if(volatility.contracting)
{

range+=20;

}




//============================================================
// VALUE POSITION
//============================================================


if(volume.insideValue)
{

range+=15;

}



if(volume.abovePOC)
{

bull+=5;

}

else

{

bear+=5;

}



//============================================================
// LIQUIDITY EVENTS
//============================================================


if(liquidity.bullishSweep)
{

bull+=10;

}



if(liquidity.bearishSweep)
{

bear+=10;

}




//============================================================
// NORMALIZE
//============================================================


double total =
bull+
bear+
range;



if(total<=0)
return;



state.bullProbability =
(bull/total)*100;



state.bearProbability =
(bear/total)*100;



state.rangeProbability =
(range/total)*100;



state.confidence =
MathMax(
state.bullProbability,
MathMax(
state.bearProbability,
state.rangeProbability
)
);



//============================================================
// FINAL REGIME
//============================================================



if(state.bullProbability>=70)
{

if(state.bullProbability>=85)

state.regime =
REGIME_STRONG_BULL;

else

state.regime =
REGIME_BULL;


state.description=
"BULLISH ENVIRONMENT";


}



else if(state.bearProbability>=70)

{


if(state.bearProbability>=85)

state.regime =
REGIME_STRONG_BEAR;


else

state.regime =
REGIME_BEAR;



state.description=
"BEARISH ENVIRONMENT";


}




else if(state.rangeProbability>=60)

{

state.regime=
REGIME_RANGE;


state.description=
"BALANCED MARKET";


}


else

{

state.regime=
REGIME_UNKNOWN;


state.description=
"UNCLEAR CONDITIONS";


}


}



//------------------------------------------------------------

RegimeState GetState()
{

return state;

}


};
//============================================================
