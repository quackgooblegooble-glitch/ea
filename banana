struct RiskState
{

   double riskPercent;

   double lotSize;


   double stopLoss;

   double takeProfit;



   bool allowed;


   string reason;

};
//+------------------------------------------------------------------+
//|                    AEGIS Risk Engine                             |
//|                    Capital Protection Layer                      |
//+------------------------------------------------------------------+

#pragma once


#include "CoreTypes.mqh"



class RiskEngine
{


private:


double accountRisk;


double maxDailyLoss;


int maxLosses;


int lossCount;



public:


RiskEngine()
{

accountRisk = 1.0;

maxDailyLoss = 3.0;

maxLosses = 3;

lossCount = 0;

}



//------------------------------------------------------------
// CONFIGURATION
//------------------------------------------------------------

void SetRisk(double percent)
{

accountRisk = percent;

}




void SetProtection(
double dailyLoss,
int losses
)
{

maxDailyLoss=dailyLoss;

maxLosses=losses;

}



//------------------------------------------------------------
// CHECK PERMISSION
//------------------------------------------------------------

bool CheckPermission()
{


if(lossCount>=maxLosses)
{

return false;

}



return true;


}



//------------------------------------------------------------
// ATR STOP CALCULATION
//------------------------------------------------------------

double CalculateStop(
double atr,
bool buy
)
{


double price;



if(buy)

price =
SymbolInfoDouble(
_Symbol,
SYMBOL_ASK
);


else

price =
SymbolInfoDouble(
_Symbol,
SYMBOL_BID
);



double distance =
atr*2.0;



if(buy)

return price-distance;


else

return price+distance;


}



//------------------------------------------------------------
// POSITION SIZE
//------------------------------------------------------------

double CalculateLot(
double stopDistance
)
{


double equity =
AccountInfoDouble(
ACCOUNT_EQUITY
);



double riskMoney =
equity*
(accountRisk/100.0);



double tickValue =
SymbolInfoDouble(
_Symbol,
SYMBOL_TRADE_TICK_VALUE
);



double tickSize =
SymbolInfoDouble(
_Symbol,
SYMBOL_TRADE_TICK_SIZE
);



if(
tickValue<=0 ||
tickSize<=0
)

return 0.01;



double lossPerLot =
(
stopDistance/tickSize
)
*
tickValue;



if(lossPerLot<=0)

return 0.01;



double lots =
riskMoney/lossPerLot;



return NormalizeLot(lots);


}



//------------------------------------------------------------
// LOT NORMALIZER
//------------------------------------------------------------

double NormalizeLot(double lot)
{


double minLot =
SymbolInfoDouble(
_Symbol,
SYMBOL_VOLUME_MIN
);


double maxLot =
SymbolInfoDouble(
_Symbol,
SYMBOL_VOLUME_MAX
);


double step =
SymbolInfoDouble(
_Symbol,
SYMBOL_VOLUME_STEP
);



lot =
MathFloor(
lot/step
)
*
step;



return MathMax(
minLot,
MathMin(
maxLot,
lot
)
);


}



//------------------------------------------------------------
// STATE
//------------------------------------------------------------

RiskState GetState()
{


RiskState state;


state.riskPercent=
accountRisk;



state.allowed =
CheckPermission();



if(!state.allowed)

state.reason=
"LOSS PROTECTION ACTIVE";

else

state.reason=
"RISK OK";



return state;


}


};
