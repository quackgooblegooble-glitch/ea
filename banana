#pragma once

#include "CoreTypes.mqh"
#include "MarketCache.mqh"



class ATREngine
{


private:


   MarketCache *market;


   int atrPeriod;


   double currentATR;

   double averageATR;


public:


   ATREngine()
   {

      market=NULL;

      atrPeriod=14;

      currentATR=0;

      averageATR=0;

   }



//------------------------------------------------------------
// INITIALIZE
//------------------------------------------------------------

   void Init(
      MarketCache &cache,
      int period=14
   )
   {

      market=&cache;

      atrPeriod=period;

   }




//------------------------------------------------------------
// UPDATE VOLATILITY DATA
//------------------------------------------------------------

   bool Update()
   {


      if(market==NULL)
         return false;



      double atrSum=0;


      int sample=50;



      for(int i=1;i<=sample;i++)
      {


         double tr =
         TrueRange(i);



         atrSum+=tr;


      }



      averageATR =
      atrSum/sample;



      currentATR =
      CalculateATR();



      return true;

   }



//------------------------------------------------------------
// TRUE RANGE
//------------------------------------------------------------

   double TrueRange(int shift)
   {


      double high =
      market.High(shift);



      double low =
      market.Low(shift);



      double previousClose =
      market.Close(shift+1);



      double range1 =
      high-low;


      double range2 =
      MathAbs(
      high-previousClose
      );


      double range3 =
      MathAbs(
      low-previousClose
      );



      return MathMax(
         range1,
         MathMax(
            range2,
            range3
         )
      );

   }





//------------------------------------------------------------
// ATR CALCULATION
//------------------------------------------------------------

   double CalculateATR()
   {


      double sum=0;



      for(int i=1;i<=atrPeriod;i++)
      {

         sum+=TrueRange(i);

      }


      return sum/atrPeriod;


   }




//------------------------------------------------------------
// VOLATILITY RATIO
//------------------------------------------------------------

   double VolatilityRatio()
   {

      if(averageATR<=0)
         return 0;


      return currentATR/
             averageATR;

   }



//------------------------------------------------------------
// STATE GENERATION
//------------------------------------------------------------

   VolatilityState GetState()
   {


      VolatilityState state;



      state.atr=currentATR;


      state.atrAverage=
      averageATR;



      state.volatilityRatio=
      VolatilityRatio();



      state.expanding =
      state.volatilityRatio > 1.15;



      state.contracting =
      state.volatilityRatio < 0.85;



      return state;

   }



//------------------------------------------------------------
// VOLATILITY QUALITY SCORE
//------------------------------------------------------------

   double Score()
   {


      double ratio=
      VolatilityRatio();



      double score=0;



      /*
      
      Ideal:
      
      1.0 - 1.5
      
      Healthy movement
      
      */


      if(ratio>=1.0 &&
         ratio<=1.5)
      {
         score+=5;
      }



      // Expansion bonus

      if(ratio>1.15)
      {
         score+=2;
      }



      // Too dead

      if(ratio<0.7)
      {
         score-=3;
      }



      // Extreme volatility

      if(ratio>2.5)
      {
         score-=5;
      }



      return MathMax(
         0,
         MathMin(
            5,
            score
         )
      );

   }



};
