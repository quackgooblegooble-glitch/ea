#pragma once


#include "CoreTypes.mqh"
#include "MarketCache.mqh"



class LiquidityEngine
{


private:


MarketCache *market;


double previousDayHigh;

double previousDayLow;


double previousWeekHigh;

double previousWeekLow;



bool bullishSweep;

bool bearishSweep;



public:



LiquidityEngine()
{

market=NULL;

previousDayHigh=0;

previousDayLow=0;

previousWeekHigh=0;

previousWeekLow=0;


bullishSweep=false;

bearishSweep=false;

}



//------------------------------------------------------------

void Init(MarketCache &cache)
{

market=&cache;

}



//------------------------------------------------------------
// UPDATE
//------------------------------------------------------------

bool Update()
{

if(market==NULL)
return false;



CalculateReferenceLevels();


DetectSweeps();



return true;

}



//------------------------------------------------------------
// REFERENCE LEVELS
//------------------------------------------------------------

void CalculateReferenceLevels()
{


MqlRates day[];


ArraySetAsSeries(
day,
true
);



CopyRates(
_Symbol,
PERIOD_D1,
0,
10,
day
);



previousDayHigh =
day[1].high;


previousDayLow =
day[1].low;



MqlRates week[];


ArraySetAsSeries(
week,
true
);



CopyRates(
_Symbol,
PERIOD_W1,
0,
10,
week
);



previousWeekHigh =
week[1].high;


previousWeekLow =
week[1].low;


}



//------------------------------------------------------------
// SWEEP DETECTION
//------------------------------------------------------------

void DetectSweeps()
{


double currentHigh =
market.High(1);



double currentLow =
market.Low(1);



double currentClose =
market.Close(1);



//------------------------------------------------
// Bearish liquidity sweep
//------------------------------------------------


// Price takes highs,
// then closes back below


if(
currentHigh > previousDayHigh
&&
currentClose < previousDayHigh
)
{

bearishSweep=true;

}




//------------------------------------------------
// Bullish liquidity sweep
//------------------------------------------------


// Price takes lows,
// then closes back above


if(
currentLow < previousDayLow
&&
currentClose > previousDayLow
)
{

bullishSweep=true;

}


}



//------------------------------------------------------------
// OUTPUT
//------------------------------------------------------------

LiquidityState GetState()
{


LiquidityState state;



state.previousDayHigh =
previousDayHigh;


state.previousDayLow =
previousDayLow;


state.previousWeekHigh =
previousWeekHigh;


state.previousWeekLow =
previousWeekLow;



state.bullishSweep =
bullishSweep;


state.bearishSweep =
bearishSweep;



state.buySideLiquidityTaken =
bearishSweep;


state.sellSideLiquidityTaken =
bullishSweep;



state.liquidityScore =
CalculateScore();



return state;

}



//------------------------------------------------------------
// SCORING
//------------------------------------------------------------

double CalculateScore()
{


double score=0;



if(bullishSweep)
score+=10;



if(bearishSweep)
score+=10;



return MathMin(
score,
10
);


}



};
