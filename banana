//============================================================
// MAIN LOOP
//============================================================


void OnTick()
{


datetime currentBar =
iTime(
_Symbol,
_Period,
0
);



bool newBar =
(
currentBar != lastBar
);



if(newBar)

lastBar=currentBar;



//============================================================
// UPDATE MARKET DATA
//============================================================


market.Update();




//============================================================
// UPDATE ANALYSIS MODULES
//============================================================


atr.Update();


structure.Update();


vwap.Update();


volume.Update();


liquidity.Update();



//============================================================
// BUILD MARKET VIEW
//============================================================


RegimeState regimeState;



regime.Update(

structure.GetState(),

vwap.GetState(),

atr.GetState(),

volume.GetState(),

liquidity.GetState()

);



regimeState =
regime.GetState();




//============================================================
// SCORE OPPORTUNITY
//============================================================



confidence.Calculate(

regimeState,

structure.GetState(),

vwap.GetState(),

volume.GetState(),

liquidity.GetState(),

GetMomentum()

);



ConfidenceState decision =
confidence.GetState();




//============================================================
// TRADE DECISION
//============================================================



if(
decision.allowTrade
&&
newBar
)

{


RiskState riskState =
risk.GetState();



if(
riskState.allowed
)

{


ExecuteDecision(
decision
);


}


}



//============================================================
// POSITION MANAGEMENT
//============================================================


manager.MoveToBreakEven();



//============================================================
// DISPLAY
//============================================================


Dashboard(
regimeState,
decision
);



}



//============================================================
// EXECUTION LOGIC
//============================================================


void ExecuteDecision(
ConfidenceState decision
)
{


double atrValue =
atr.GetValue();



double lots =
risk.CalculateLot(
atrValue*2
);



if(decision.allowLong)
{


double sl =
risk.CalculateStop(
atrValue,
true
);



execution.Buy(
lots,
sl,
0
);


Print(
"AEGIS LONG EXECUTED"
);


}




if(decision.allowShort)
{


double sl =
risk.CalculateStop(
atrValue,
false
);



execution.Sell(
lots,
sl,
0
);


Print(
"AEGIS SHORT EXECUTED"
);


}



}



