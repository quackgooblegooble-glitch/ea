#pragma once


#include "CoreTypes.mqh"
#include "MarketCache.mqh"



class VWAPEngine
{


private:


   MarketCache *market;



   double dailyVWAP;

   double weeklyVWAP;

   double monthlyVWAP;



   double dailySlope;



public:


   VWAPEngine()
   {

      market=NULL;

      dailyVWAP=0;

      weeklyVWAP=0;

      monthlyVWAP=0;

      dailySlope=0;

   }



//------------------------------------------------------------
// INITIALIZE
//------------------------------------------------------------

void Init(MarketCache &cache)
{

   market=&cache;

}



//------------------------------------------------------------
// UPDATE
//------------------------------------------------------------

bool Update()
{


   if(market==NULL)
      return false;



   dailyVWAP =
   CalculateVWAP(
      PERIOD_D1
   );


   weeklyVWAP =
   CalculateVWAP(
      PERIOD_W1
   );


   monthlyVWAP =
   CalculateVWAP(
      PERIOD_MN1
   );



   dailySlope =
   CalculateSlope();



   return true;

}





//------------------------------------------------------------
// VWAP CALCULATION
//------------------------------------------------------------

double CalculateVWAP(
ENUM_TIMEFRAMES timeframe
)
{


   MqlRates data[];


   ArraySetAsSeries(
      data,
      true
   );



   int copied =
   CopyRates(
      _Symbol,
      timeframe,
      0,
      500,
      data
   );



   if(copied<=0)
      return 0;



   double volumeSum=0;

   double priceVolumeSum=0;



   for(int i=0;i<copied;i++)
   {


      double typicalPrice =
      (
       data[i].high +
       data[i].low +
       data[i].close
      ) / 3.0;



      double volume =
      data[i].tick_volume;



      priceVolumeSum +=
      typicalPrice * volume;



      volumeSum +=
      volume;


   }



   if(volumeSum==0)
      return 0;



   return
   priceVolumeSum /
   volumeSum;


}



//------------------------------------------------------------
// VWAP SLOPE
//------------------------------------------------------------

double CalculateSlope()
{


   double previous =
   CalculateVWAP(
      PERIOD_D1
   );



   if(previous==0)
      return 0;



   return
   dailyVWAP -
   previous;


}



//------------------------------------------------------------
// GET STATE
//------------------------------------------------------------

VWAPState GetState()
{


   VWAPState state;



   state.dailyVWAP =
   dailyVWAP;



   state.weeklyVWAP =
   weeklyVWAP;



   state.monthlyVWAP =
   monthlyVWAP;



   double price =
   market.Close(0);




   state.aboveDaily =
   price > dailyVWAP;



   state.aboveWeekly =
   price > weeklyVWAP;



   state.aboveMonthly =
   price > monthlyVWAP;



   state.slope =
   dailySlope;



   state.distanceATR =
   CalculateDistance();



   return state;

}



//------------------------------------------------------------
// DISTANCE FROM VALUE
//------------------------------------------------------------

double CalculateDistance()
{


   double price =
   market.Close(0);



   if(dailyVWAP==0)
      return 0;



   double atr =
   MathAbs(
   market.High(1)
   -
   market.Low(1)
   );



   if(atr==0)
      return 0;



   return
   (price-dailyVWAP)
   /
   atr;


}



//------------------------------------------------------------
// VWAP SCORE
//------------------------------------------------------------

double Score()
{


   double score=0;



   double price =
   market.Close(0);




// Price alignment

   if(price > dailyVWAP)
      score+=5;



   if(price > weeklyVWAP)
      score+=5;



   if(price > monthlyVWAP)
      score+=5;



// Slope

   if(dailySlope>0)
      score+=5;



   return
   MathMin(
      score,
      20
   );


}



};
