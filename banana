#pragma once


#include "CoreTypes.mqh"
#include "MarketCache.mqh"



class VolumeProfileEngine
{


private:


MarketCache *market;



double priceStep;



double poc;

double vah;

double val;



double highVolumeNode;

double lowVolumeNode;



public:



VolumeProfileEngine()
{

market=NULL;

priceStep=0;

poc=0;

vah=0;

val=0;

highVolumeNode=0;

lowVolumeNode=0;

}



//------------------------------------------------------------

void Init(MarketCache &cache)
{

market=&cache;

}



//------------------------------------------------------------
// MAIN UPDATE
//------------------------------------------------------------

bool Update()
{


if(market==NULL)
return false;



CalculateProfile();



return true;


}



//------------------------------------------------------------
// BUILD PROFILE
//------------------------------------------------------------

void CalculateProfile()
{


double highest =
market.High(100);



double lowest =
market.Low(100);



for(int i=100;i>=1;i--)
{

highest=MathMax(
highest,
market.High(i)
);


lowest=MathMin(
lowest,
market.Low(i)
);

}



// price bucket size

priceStep =
(highest-lowest)
/100.0;



if(priceStep<=0)
return;



double volumeMap[];

ArrayResize(
volumeMap,
100
);



ArrayInitialize(
volumeMap,
0
);



//------------------------------------------------
// distribute volume
//------------------------------------------------


for(int i=1;i<100;i++)
{


double price =
market.Close(i);



int bucket =
(int)
(
(price-lowest)
/
priceStep
);



if(bucket>=0 &&
bucket<100)
{


volumeMap[bucket]
+=
market.Volume(i);


}


}



//------------------------------------------------
// Find POC
//------------------------------------------------


double maxVolume=0;

int pocIndex=0;



for(int i=0;i<100;i++)
{


if(volumeMap[i]>maxVolume)
{

maxVolume=
volumeMap[i];


pocIndex=i;

}


}



poc =
lowest+
(pocIndex*priceStep);



//------------------------------------------------
// Calculate Value Area
//------------------------------------------------


CalculateValueArea(
volumeMap,
lowest
);



}



//------------------------------------------------------------
// VALUE AREA CALCULATION
//------------------------------------------------------------

void CalculateValueArea(
double &volume[],
double lowest
)
{


double total=0;


for(int i=0;i<ArraySize(volume);i++)
{

total+=volume[i];

}



double target =
total*0.70;



double accumulated=0;



int lowIndex=0;

int highIndex=99;



for(int i=0;i<ArraySize(volume);i++)
{


accumulated+=volume[i];


if(accumulated>=target)
{

highIndex=i;

break;

}


}




val =
lowest+
(lowIndex*priceStep);



vah =
lowest+
(highIndex*priceStep);



}



//------------------------------------------------------------
// STATE OUTPUT
//------------------------------------------------------------

VolumeProfileState GetState()
{


VolumeProfileState state;



double price =
market.Close(0);



state.poc=poc;


state.vah=vah;


state.val=val;



state.abovePOC =
price>poc;



state.insideValue =
(
price<=vah &&
price>=val
);



state.nearHighVolumeNode =
false;


state.nearLowVolumeNode =
false;



return state;


}



//------------------------------------------------------------
// SCORE
//------------------------------------------------------------

double Score(bool bullish)
{


double score=0;


double price =
market.Close(0);



// bullish context

if(bullish)
{


if(price>poc)
score+=5;


if(price>vah)
score+=5;


}



// bearish context

else
{


if(price<poc)
score+=5;


if(price<val)
score+=5;


}



return
MathMin(
score,
15
);


}


};
