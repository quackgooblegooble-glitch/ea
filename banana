#pragma once


#include "CoreTypes.mqh"
#include "MarketCache.mqh"



class MarketStructureEngine
{


private:


   MarketCache *market;



   double lastSwingHigh;

   double lastSwingLow;


   double previousSwingHigh;

   double previousSwingLow;



   bool bullishStructure;

   bool bearishStructure;



public:


   MarketStructureEngine()
   {

      market=NULL;

      lastSwingHigh=0;

      lastSwingLow=0;

      previousSwingHigh=0;

      previousSwingLow=0;


      bullishStructure=false;

      bearishStructure=false;

   }




//------------------------------------------------------------
// INITIALIZE
//------------------------------------------------------------

void Init(MarketCache &cache)
{

   market=&cache;

}



//------------------------------------------------------------
// MAIN UPDATE
//------------------------------------------------------------

bool Update()
{


   if(market==NULL)
      return false;



   FindSwings();


   return true;

}



//------------------------------------------------------------
// SWING HIGH DETECTION
//------------------------------------------------------------

bool IsSwingHigh(int shift)
{


   double current =
   market.High(shift);



   for(int i=1;i<=2;i++)
   {


      if(current <= market.High(shift+i))
         return false;



      if(current <= market.High(shift-i))
         return false;


   }


   return true;

}



//------------------------------------------------------------
// SWING LOW DETECTION
//------------------------------------------------------------

bool IsSwingLow(int shift)
{


   double current =
   market.Low(shift);



   for(int i=1;i<=2;i++)
   {

      if(current >= market.Low(shift+i))
         return false;


      if(current >= market.Low(shift-i))
         return false;

   }


   return true;

}




//------------------------------------------------------------
// FIND STRUCTURE POINTS
//------------------------------------------------------------

void FindSwings()
{


   for(int i=10;i<50;i++)
   {


      if(IsSwingHigh(i))
      {


         previousSwingHigh =
         lastSwingHigh;



         lastSwingHigh =
         market.High(i);



         break;

      }


   }



   for(int i=10;i<50;i++)
   {


      if(IsSwingLow(i))
      {


         previousSwingLow =
         lastSwingLow;



         lastSwingLow =
         market.Low(i);



         break;

      }


   }



}




//------------------------------------------------------------
// GENERATE STRUCTURE STATE
//------------------------------------------------------------

StructureState GetState()
{


   StructureState state;



   state.higherHigh=false;

   state.higherLow=false;

   state.lowerHigh=false;

   state.lowerLow=false;



   state.breakOfStructure=false;

   state.changeOfCharacter=false;



   state.lastSwingHigh =
   lastSwingHigh;


   state.lastSwingLow =
   lastSwingLow;



//------------------------------------------------
// CLASSIFY SWINGS
//------------------------------------------------


   if(lastSwingHigh >
      previousSwingHigh)
   {

      state.higherHigh=true;

   }



   if(lastSwingLow >
      previousSwingLow)
   {

      state.higherLow=true;

   }



   if(lastSwingHigh <
      previousSwingHigh)
   {

      state.lowerHigh=true;

   }



   if(lastSwingLow <
      previousSwingLow)
   {

      state.lowerLow=true;

   }



//------------------------------------------------
// TREND DIRECTION
//------------------------------------------------


   if(state.higherHigh &&
      state.higherLow)
   {


      bullishStructure=true;

      bearishStructure=false;


   }



   if(state.lowerHigh &&
      state.lowerLow)
   {


      bearishStructure=true;

      bullishStructure=false;


   }



   state.trendStrength =
   CalculateStrength(state);



   return state;

}





//------------------------------------------------------------
// STRUCTURE SCORE
//------------------------------------------------------------

double CalculateStrength(
StructureState &state
)
{


   double score=0;



   if(state.higherHigh)
      score+=25;



   if(state.higherLow)
      score+=25;



   if(state.lowerHigh)
      score+=25;



   if(state.lowerLow)
      score+=25;



   return score;

}




};
