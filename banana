#pragma once


class MarketCache
{


private:


   MqlRates rates[];


   int barsLoaded;



public:


   bool Update(int requestedBars)
   {


      ArraySetAsSeries(
         rates,
         true
      );


      int copied =
      CopyRates(
         _Symbol,
         _Period,
         0,
         requestedBars,
         rates
      );


      if(copied <=0)
      {
         Print(
         "AEGIS Cache Error: ",
         GetLastError()
         );

         return false;
      }



      barsLoaded=copied;


      return true;

   }



//------------------------------------------------------------
// ACCESSORS
//------------------------------------------------------------


   double Open(int shift)
   {

      if(shift>=barsLoaded)
         return 0;

      return rates[shift].open;

   }



   double High(int shift)
   {

      if(shift>=barsLoaded)
         return 0;

      return rates[shift].high;

   }




   double Low(int shift)
   {

      if(shift>=barsLoaded)
         return 0;

      return rates[shift].low;

   }




   double Close(int shift)
   {

      if(shift>=barsLoaded)
         return 0;

      return rates[shift].close;

   }




   long Volume(int shift)
   {

      if(shift>=barsLoaded)
         return 0;


      return rates[shift].tick_volume;

   }



   datetime Time(int shift)
   {

      if(shift>=barsLoaded)
         return 0;


      return rates[shift].time;

   }



   int Size()
   {

      return barsLoaded;

   }


};
